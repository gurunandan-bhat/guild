{{- $languages := hugo.Data.languages.languages }}
{{- $films := dict }}
{{- range .Pages }}
	{{- $pageMap := (jsonify .) | transform.Unmarshal }}
	{{- $reviewTitle := partialCached "tag-to-title.html" .LinkTitle .LinkTitle }}
	{{- $score := partialCached "fcg-rating-raw.html" .LinkTitle .LinkTitle  }}
	{{- $posterLink := partial "poster-link.html" $reviewTitle }}
	{{- $pageMap = merge $pageMap (dict "AverageScore" (div $score 10.0) "URLPath" (urlize .Path)) }}
	{{- with $posterLink }}
		{{- $pageMap = merge $pageMap (dict "LocalPosterPath" .) }}
	{{- end }}
	{{- $language := dict }}
	{{- with partialCached "tmdb-meta.html" $reviewTitle $reviewTitle }}
		{{- $language = index $languages .original_language }}
		{{- with $language }}
			{{- $pageMap = merge $pageMap (dict "Language" .english_name) }}
		{{- end }}
	{{- end }}
	{{- $key := (md5 $reviewTitle) }}
	{{- $films = merge $films (dict $key $pageMap) }}
{{- end }}
{{- $films | jsonify (dict "prefix" "" "indent" "\t") }}
